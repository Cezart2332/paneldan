# Unde trimite paneldan request-urile /api in dev (proxy Vite).
# Trebuie sa fie ACELASI backend unde ai setat ADMIN_TOKEN.

# Backend local (implicit daca nu setezi nimic):
VITE_API_PROXY_TARGET=http://127.0.0.1:3000

# Productie (decomenteaza daca vrei sa administrezi serverul live):
# VITE_API_PROXY_TARGET=https://api.danfostanxios.ro

# La build productie (npm run build), URL-ul complet al API-ului:
# VITE_API_URL=https://api.danfostanxios.ro
